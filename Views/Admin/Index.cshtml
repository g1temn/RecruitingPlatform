@model RecruitingPlatform.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Панель адміністратора";
}

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full font-inter flex-grow">

    <div class="mb-8">
        <h1 class="font-poppins font-bold text-3xl sm:text-4xl text-brand-dark">
            Панель адміністратора
        </h1>
        <p class="text-gray-500 mt-2 text-sm sm:text-base">Керування контентом платформи: резюме та вакансії.</p>
    </div>

    <div class="flex border-b border-gray-200 mb-6">
        <a asp-controller="Admin" asp-action="Index" asp-route-tab="resumes" asp-route-page="1"
           class="py-3 px-6 font-semibold text-sm transition-colors border-b-2 @(Model.ActiveTab == "resumes" ? "border-brand-blue text-brand-blue" : "border-transparent text-gray-500 hover:text-brand-dark")">
            Резюме
        </a>
        <a asp-controller="Admin" asp-action="Index" asp-route-tab="vacancies" asp-route-page="1"
           class="py-3 px-6 font-semibold text-sm transition-colors border-b-2 @(Model.ActiveTab == "vacancies" ? "border-brand-blue text-brand-blue" : "border-transparent text-gray-500 hover:text-brand-dark")">
            Вакансії
        </a>
    </div>

    @if (Model.ActiveTab == "resumes" && Model.Resumes != null)
    {
        <div class="bg-white shadow-sm border border-gray-200 rounded-2xl overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-600 min-w-[800px]">
                    <thead class="bg-gray-50 border-b border-gray-200 text-brand-dark font-poppins">
                        <tr>
                            <th class="px-6 py-4 font-bold whitespace-nowrap">ID</th>
                            <th class="px-6 py-4 font-bold whitespace-nowrap">Посада</th>
                            <th class="px-6 py-4 font-bold whitespace-nowrap">Спеціальність</th>
                            <th class="px-6 py-4 font-bold whitespace-nowrap">Оновлено</th>
                            <th class="px-6 py-4 font-bold text-right whitespace-nowrap">Дії</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var resume in Model.Resumes.Items)
                        {
                            <tr class="hover:bg-brand-light-blue/30 transition-colors">
                                <td class="px-6 py-4 font-semibold">#@resume.Id</td>
                                <td class="px-6 py-4 font-medium text-brand-dark">@resume.Title</td>
                                <td class="px-6 py-4">@resume.Specialty?.Name</td>
                                <td class="px-6 py-4 whitespace-nowrap">@resume.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <a asp-controller="Resumes" asp-action="Edit" asp-route-id="@resume.Id" class="text-brand-blue font-semibold hover:underline mr-3">Редаг.</a>
                                    <form asp-controller="Resumes" asp-action="Delete" asp-route-id="@resume.Id" method="post" class="inline" onsubmit="return confirm('Безповоротно видалити це резюме?');">
                                        <button type="submit" class="text-brand-red font-semibold hover:underline bg-transparent border-none p-0 cursor-pointer">Видалити</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.Resumes.TotalPages > 1)
        {
            <div class="mt-6 flex justify-center gap-2 overflow-x-auto pb-2">
                <a asp-route-tab="resumes" asp-route-page="@(Model.CurrentPage - 1)" class="px-4 py-2 bg-white border border-gray-200 rounded-lg shrink-0 @(Model.CurrentPage == 1 ? "pointer-events-none opacity-50" : "hover:bg-gray-50")">&larr;</a>
                <span class="px-4 py-2 font-medium shrink-0">Сторінка @Model.CurrentPage з @Model.Resumes.TotalPages</span>
                <a asp-route-tab="resumes" asp-route-page="@(Model.CurrentPage + 1)" class="px-4 py-2 bg-white border border-gray-200 rounded-lg shrink-0 @(Model.CurrentPage == Model.Resumes.TotalPages ? "pointer-events-none opacity-50" : "hover:bg-gray-50")">&rarr;</a>
            </div>
        }
    }

    @if (Model.ActiveTab == "vacancies" && Model.Vacancies != null)
    {
        <div class="bg-white shadow-sm border border-gray-200 rounded-2xl overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-600 min-w-[800px]">
                    <thead class="bg-gray-50 border-b border-gray-200 text-brand-dark font-poppins">
                        <tr>
                            <th class="px-6 py-4 font-bold whitespace-nowrap">ID</th>
                            <th class="px-6 py-4 font-bold whitespace-nowrap">Назва</th>
                            <th class="px-6 py-4 font-bold whitespace-nowrap">Компанія</th>
                            <th class="px-6 py-4 font-bold whitespace-nowrap">Статус</th>
                            <th class="px-6 py-4 font-bold text-right whitespace-nowrap">Дії</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var vac in Model.Vacancies.Items)
                        {
                            <tr class="hover:bg-brand-light-blue/30 transition-colors">
                                <td class="px-6 py-4 font-semibold">#@vac.Id</td>
                                <td class="px-6 py-4 font-medium text-brand-dark">@vac.Title</td>
                                <td class="px-6 py-4">@vac.Company?.Name</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2 py-1 rounded-md text-xs font-bold @(vac.IsActive ? "bg-brand-mint text-brand-dark" : "bg-gray-200 text-gray-600")">
                                        @(vac.IsActive ? "Активна" : "Прихована")
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <a asp-controller="Vacancies" asp-action="Edit" asp-route-id="@vac.Id" class="text-brand-blue font-semibold hover:underline mr-3">Редаг.</a>
                                    <form asp-controller="Vacancies" asp-action="Delete" asp-route-id="@vac.Id" method="post" class="inline" onsubmit="return confirm('Безповоротно видалити цю вакансію?');">
                                        <button type="submit" class="text-brand-red font-semibold hover:underline bg-transparent border-none p-0 cursor-pointer">Видалити</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.Vacancies.TotalPages > 1)
        {
            <div class="mt-6 flex justify-center gap-2 overflow-x-auto pb-2">
                <a asp-route-tab="vacancies" asp-route-page="@(Model.CurrentPage - 1)" class="px-4 py-2 bg-white border border-gray-200 rounded-lg shrink-0 @(Model.CurrentPage == 1 ? "pointer-events-none opacity-50" : "hover:bg-gray-50")">&larr;</a>
                <span class="px-4 py-2 font-medium shrink-0">Сторінка @Model.CurrentPage з @Model.Vacancies.TotalPages</span>
                <a asp-route-tab="vacancies" asp-route-page="@(Model.CurrentPage + 1)" class="px-4 py-2 bg-white border border-gray-200 rounded-lg shrink-0 @(Model.CurrentPage == Model.Vacancies.TotalPages ? "pointer-events-none opacity-50" : "hover:bg-gray-50")">&rarr;</a>
            </div>
        }
    }
</main>
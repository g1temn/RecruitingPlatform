@{
    ViewData["Title"] = "Sign Up";
}

<div class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full bg-white rounded-2xl shadow-sm border border-gray-100 p-8">

        <div class="text-center mb-8">
            <h1 class="font-poppins text-2xl font-bold text-brand-dark mb-2">Create an Account</h1>
            <p class="text-sm text-gray-500">Select your account type and enter your credentials to get started</p>
        </div>

        <form method="post" asp-controller="Auth" asp-action="SignUp" class="space-y-5">

            <div>
                <p class="block text-sm font-semibold text-gray-700 mb-2">I want to join as</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <label class="cursor-pointer">
                        <input type="radio" name="Role" value="JobSeeker" class="peer sr-only" checked>
                        <div class="flex flex-col items-center justify-center p-3 rounded-xl border border-gray-200 text-gray-600 peer-checked:border-brand-blue peer-checked:bg-brand-mint/10 peer-checked:text-brand-dark transition-all">
                            <span class="text-xs font-bold">Job Seeker</span>
                        </div>
                    </label>

                    <label class="cursor-pointer">
                        <input type="radio" name="Role" value="Employer" class="peer sr-only">
                        <div class="flex flex-col items-center justify-center p-3 rounded-xl border border-gray-200 text-gray-600 peer-checked:border-brand-blue peer-checked:bg-brand-mint/10 peer-checked:text-brand-dark transition-all">
                            <span class="text-xs font-bold">Employer</span>
                        </div>
                    </label>
                </div>
            </div>

            <div>
                <label for="email" class="block text-sm font-semibold text-gray-700 mb-1.5">Email address</label>
                <input type="email" id="email" name="email" required placeholder="name@gmail.com"
                       class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition-all placeholder:text-gray-400">
            </div>

            <div>
                <label for="password" class="block text-sm font-semibold text-gray-700 mb-1.5">Password</label>
                <input type="password" id="password" name="password" required placeholder="••••••••"
                       class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition-all placeholder:text-gray-400">
            </div>

            <div>
                <label for="repeatPassword" class="block text-sm font-semibold text-gray-700 mb-1.5">Confirm Password</label>
                <input type="password" id="repeatPassword" name="repeatPassword" required placeholder="••••••••"
                       class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition-all placeholder:text-gray-400">
            </div>

            <button 
                type="submit"
                class="w-full bg-brand-blue text-white py-3 rounded-full font-bold text-sm transition-all hover:bg-brand-dark focus:outline-none focus:ring-2 focus:ring-brand-blue/50"
            >
                Continue Setup
            </button>
        </form>

        <p class="mt-8 text-center text-sm text-gray-500">
            Already have an account?
            <a 
                asp-controller="Auth"
                asp-action="LogIn"
                class="font-semibold text-brand-blue hover:underline">Log In</a>
        </p>
    </div>
</div>
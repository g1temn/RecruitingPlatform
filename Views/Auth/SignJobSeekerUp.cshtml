@model RecruitingPlatform.DTOs.Auth.SignJobSeekerUpDto
@{
    ViewData["Title"] = "Job Seeker Details";
    var baseData = ViewBag.BaseData as RecruitingPlatform.DTOs.Auth.SignUpBaseDto;
}

<div class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full bg-white rounded-2xl shadow-sm border border-gray-100 p-8">

        <div class="text-center mb-8">
            <h1 class="font-poppins text-2xl font-bold text-brand-dark mb-2">Tell us about yourself</h1>
            <p class="text-sm text-gray-500">Please provide your personal details to complete registration</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bg-red-50 border-l-4 border-brand-red p-4 mb-6 rounded-r-xl shadow-sm">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-brand-red" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <div class="ml-3">
                        <h3 class="text-sm font-semibold text-brand-red">Registration Errors:</h3>
                        <div class="mt-2 text-sm text-red-700">
                            <div asp-validation-summary="All" class="list-disc pl-5 space-y-1"></div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <form method="post" asp-controller="Auth" asp-action="SignJobSeekerUp" class="space-y-5">
            <input type="hidden" name="Email" value="@baseData?.Email" />
            <input type="hidden" name="Password" value="@baseData?.Password" />
            <input type="hidden" name="Role" value="@baseData?.Role" />
            <input type="hidden" name="ConfirmPassword" value="@baseData?.ConfirmPassword" />

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="FirstName" class="block text-sm font-semibold text-gray-700 mb-1.5">First Name</label>
                    <input asp-for="FirstName" required placeholder="John"
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition-all">
                </div>
                <div>
                    <label asp-for="LastName" class="block text-sm font-semibold text-gray-700 mb-1.5">Last Name</label>
                    <input asp-for="LastName" required placeholder="Doe"
                           class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition-all">
                </div>
            </div>

            <div>
                <label asp-for="ContactEmail" class="block text-sm font-semibold text-gray-700 mb-1.5">Contact Email</label>
                <input asp-for="ContactEmail" type="email" required placeholder="contact@example.com" value="@baseData?.Email"
                       class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition-all">
            </div>

            <div>
                <label asp-for="ContactPhone" class="block text-sm font-semibold text-gray-700 mb-1.5">Phone Number</label>
                <input asp-for="ContactPhone" type="tel" required placeholder="+380..."
                       class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition-all">
            </div>

            <div>
                <label asp-for="Birthday" class="block text-sm font-semibold text-gray-700 mb-1.5">Date of Birth</label>
                <input asp-for="Birthday" type="date" required
                       class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition-all">
            </div>

            <button type="submit"
                    class="w-full bg-brand-blue text-white py-3 mt-4 rounded-full font-bold text-sm transition-all hover:bg-brand-dark focus:outline-none focus:ring-2 focus:ring-brand-blue/50">
                Complete Registration
            </button>
        </form>
    </div>
</div>
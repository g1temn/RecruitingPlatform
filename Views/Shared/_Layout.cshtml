<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RecruitingPlatform</title>
    <link rel="stylesheet" href="~/css/output.css" />
</head>
<body class="min-h-screen flex flex-col font-inter bg-brand-light-blue text-gray-900">

    <header class="bg-white border-b border-gray-100 sticky top-0 z-50">
        <div class="px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">

            <div class="flex items-center gap-8">

                <div class="font-poppins font-extrabold text-2xl tracking-tight text-brand-dark">
                    <a asp-controller="Home" asp-action="Index">
                        Recruiting<span class="text-brand-blue">Platform</span>
                    </a>
                </div>

                <nav class="hidden md:flex gap-6 text-sm font-semibold text-gray-600">
                    @* <a href="#" class="hover:text-brand-blue flex items-center gap-1">Candidates </a>
                    <a href="#" class="hover:text-brand-blue flex items-center gap-1">Employers </a> *@
                </nav>

            </div>

            <div class="flex items-center gap-6">

                <a 
                    asp-controller="Auth"
                    asp-action="LogIn"
                    class="hidden sm:flex text-brand-blue font-semibold text-sm items-center gap-1 hover:opacity-80">
                    Log In
                </a>

                <a 
                    asp-controller="Auth"
                    asp-action="SignUp"
                    class="hidden sm:flex bg-brand-blue text-white px-6 py-2 rounded-full font-bold text-sm transition-all hover:bg-brand-dark">
                    Sign Up
                </a>

            </div>

        </div>
    </header>

    <main class="flex-grow flex flex-col">
        @RenderBody()
    </main>

    <footer class="bg-white border-t border-gray-200 text-gray-500 py-8 mt-auto">
        <div class="w-full mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center text-sm">
            <p>&copy; @DateTime.Now.Year RecruitingPlatform.</p>
            @* <div class="flex gap-6">
                <a class="hover:text-brand-blue">Privacy</a>
                <a class="hover:text-brand-blue">Terms</a>
            </div> *@
        </div>
    </footer>
</body>
</html>
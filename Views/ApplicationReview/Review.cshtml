@model RecruitingPlatform.ViewModels.Applications.ReviewApplicationViewModel
@{
    ViewData["Title"] = "Розгляд заявки";
    var jobSeeker = Model.Application.Resume?.JobSeeker;
    var resume = Model.Application.Resume;
    var vacancy = Model.Application.Vacancy;
}

<main class="max-w-6xl flex-grow mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 w-full relative flex flex-col font-inter">

    <div class="mb-6 sm:mb-8 flex flex-col gap-4">
        <a asp-controller="EmployerProfile" asp-action="Index"
           class="text-brand-blue hover:text-brand-dark font-medium flex items-center gap-2 transition-colors w-fit text-sm sm:text-base">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Назад до профілю
        </a>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="w-full bg-brand-mint/20 border border-brand-mint/50 text-brand-dark px-5 py-4 rounded-xl flex items-center gap-3 shadow-sm">
                <span class="font-semibold text-sm sm:text-base">@TempData["SuccessMessage"]</span>
            </div>
        }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">

        <div class="lg:col-span-2 flex flex-col gap-6">

            <div class="bg-white p-6 sm:p-8 rounded-2xl border border-gray-200 shadow-sm flex flex-col gap-4">
                <div class="flex items-start justify-between border-b-2 border-brand-cyan/40 pb-4">
                    <div>
                        <span class="text-xs font-bold text-gray-400 uppercase tracking-wide">Кандидат</span>
                        <h1 class="font-poppins font-bold text-2xl sm:text-3xl text-brand-dark">
                            @(jobSeeker?.FirstName) @(jobSeeker?.LastName)
                        </h1>
                    </div>
                    <div class="text-right">
                        <span class="text-xs font-bold text-gray-400 uppercase tracking-wide">Відгук на вакансію</span>
                        <p class="font-semibold text-brand-blue text-sm sm:text-base">@vacancy?.Title</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-2">
                    <div class="flex items-center gap-3 text-sm font-medium text-gray-700">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        <a href="mailto:@jobSeeker?.ContactEmail" class="hover:text-brand-blue transition-colors">@jobSeeker?.ContactEmail</a>
                    </div>
                    <div class="flex items-center gap-3 text-sm font-medium text-gray-700">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                        <a href="tel:@jobSeeker?.ContactPhone" class="hover:text-brand-blue transition-colors">@jobSeeker?.ContactPhone</a>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Application.CoverLetter))
            {
                <div class="bg-brand-light-blue p-6 sm:p-8 rounded-2xl border border-brand-cyan/30 shadow-sm">
                    <h3 class="font-poppins font-bold text-brand-dark text-lg mb-3">Супровідний лист</h3>
                    <p class="text-sm sm:text-base text-gray-700 whitespace-pre-line leading-relaxed">
                        @Model.Application.CoverLetter
                    </p>
                </div>
            }

            <div class="bg-white p-6 sm:p-8 rounded-2xl border border-gray-200 shadow-sm flex flex-col gap-6">
                <h3 class="font-poppins font-bold text-brand-dark text-xl border-b-2 border-brand-cyan/40 pb-2">Деталі резюме</h3>

                <div class="flex flex-col gap-1">
                    <span class="text-xs font-bold text-gray-400 uppercase tracking-wide">Бажана посада (Заголовок)</span>
                    <p class="font-bold text-lg text-brand-dark">@resume?.Title</p>
                </div>

                <div class="flex flex-col gap-1">
                    <span class="text-xs font-bold text-gray-400 uppercase tracking-wide">Спеціальність</span>
                    <p class="font-medium text-brand-blue">@resume?.Specialty?.Name</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(resume?.Summary))
                {
                    <div class="flex flex-col gap-1">
                        <span class="text-xs font-bold text-gray-400 uppercase tracking-wide">Про себе (Summary)</span>
                        <p class="text-sm sm:text-base text-gray-700 whitespace-pre-line">@resume?.Summary</p>
                    </div>
                }
            </div>

        </div>

        <div class="lg:col-span-1">
            <div class="bg-white p-6 sm:p-8 rounded-2xl border border-gray-200 shadow-sm sticky top-6">

                <div class="mb-6">
                    <span class="text-xs font-bold text-gray-400 uppercase tracking-wide block mb-1">Поточний статус</span>
                    <span class="inline-block bg-brand-mint/40 text-brand-dark text-sm font-bold px-4 py-1.5 rounded-md border border-brand-mint/50">
                        @Model.Application.ApplicationStatus?.Name
                    </span>
                    <p class="text-xs text-gray-400 mt-2">Дата подачі: @Model.Application.AppliedAt.ToString("dd.MM.yyyy HH:mm")</p>
                </div>

                <form asp-controller="ApplicationReview" asp-action="Review" method="post" class="flex flex-col gap-4 border-t border-gray-100 pt-6">

                    <input type="hidden" asp-for="FormData.ApplicationId" />

                    <div class="flex flex-col gap-2">
                        <label asp-for="FormData.NewStatusId" class="font-poppins font-bold text-brand-dark text-sm">
                            Змінити статус заявки
                        </label>
                        <select asp-for="FormData.NewStatusId" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 bg-gray-50 focus:bg-white focus:outline-none focus:border-brand-blue focus:ring-4 focus:ring-brand-blue/10 transition-all text-sm font-medium">
                            @foreach (var status in Model.AvailableStatuses)
                            {
                                <option value="@status.Id">@status.Name</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="w-full mt-2 px-6 py-3 bg-brand-blue text-white font-poppins font-bold rounded-xl shadow-md transition-all hover:bg-brand-dark hover:-translate-y-0.5 hover:shadow-lg focus:ring-4 focus:ring-brand-blue/30 duration-200 text-sm">
                        Оновити статус
                    </button>
                </form>

            </div>
        </div>

    </div>
</main>
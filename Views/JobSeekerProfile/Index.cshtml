@model RecruitingPlatform.ViewModels.Profile.JobSeekerProfileViewModel
@{
    ViewData["Title"] = "Мій профіль";
    var initials = $"{(Model.FirstName?.FirstOrDefault())}{(Model.LastName?.FirstOrDefault())}".ToUpper();
    var age = DateTime.Today.Year - Model.Birthday.Year;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full font-inter flex-grow">

    <!-- Шапка профілю -->
    <div class="bg-white rounded-2xl p-6 sm:p-10 shadow-sm border border-brand-cyan/30 flex flex-col sm:flex-row items-center sm:items-start gap-6 relative overflow-hidden mb-8">

        <div class="absolute -right-16 -top-16 w-64 h-64 bg-brand-light-blue rounded-full opacity-50 z-0 pointer-events-none"></div>

        <!-- Аватар -->
        <div class="z-10 w-24 h-24 bg-brand-mint text-brand-dark rounded-full flex items-center justify-center font-poppins font-bold text-3xl shadow-sm border-4 border-white shrink-0">
            @initials
        </div>

        <!-- Особиста інформація -->
        <div class="z-10 flex flex-col items-center sm:items-start gap-2 w-full">
            <h1 class="font-poppins font-bold text-3xl text-brand-dark">@Model.FirstName @Model.LastName</h1>

            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-x-6 gap-y-3 text-sm text-gray-600 mt-2 font-medium">
                <span class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    @Model.ContactEmail
                </span>
                <span class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                    @Model.ContactPhone
                </span>
            </div>
        </div>

        <a asp-controller="JobSeekerProfile" asp-action="Edit" class="text-center z-10 sm:ml-auto mt-4 sm:mt-0 px-6 py-2 bg-brand-light-blue text-brand-dark font-semibold rounded-xl hover:bg-brand-blue hover:text-white transition-colors text-sm border border-gray-200 shadow-sm">
            Редагувати профіль
        </a>
    </div>

    <!-- Сітка: Резюме та Заявки -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- ЛІВА КОЛОНКА: Мої Резюме -->
        <div class="flex flex-col gap-5">
            <div class="flex items-center justify-between border-b-2 border-brand-cyan/40 pb-2">
                <h2 class="font-poppins font-bold text-xl text-brand-dark">Мої резюме</h2>
                <a asp-controller="Resumes" asp-action="Create" class="text-sm font-bold text-brand-blue hover:text-brand-dark transition-colors flex items-center gap-1">
                    + Створити нове
                </a>
            </div>

            @if (!Model.Resumes.Any())
            {
                <div class="bg-gray-50 border border-gray-200 rounded-2xl p-8 text-center flex flex-col items-center justify-center">
                    <p class="text-gray-500 text-sm mb-4">У вас ще немає жодного резюме. Створіть його, щоб відгукуватись на вакансії!</p>
                    <a asp-controller="Resumes" asp-action="Create" class="px-6 py-2 bg-brand-blue text-white font-bold rounded-xl hover:bg-brand-dark transition-colors text-sm">Створити резюме</a>
                </div>
            }
            else
            {
                <div class="flex flex-col gap-4">
                    @foreach (var resume in Model.Resumes)
                    {
                        <div class="bg-white border-l-4 border-brand-blue border-y border-r border-gray-200 rounded-r-2xl p-5 shadow-sm hover:shadow-md transition-shadow flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <div>
                                <h3 class="font-bold text-brand-dark text-lg">
                                    <a asp-controller="Resumes" asp-action="Details" asp-route-id="@resume.Id" class="hover:text-brand-blue transition-colors">@resume.Title</a>
                                </h3>
                                <p class="text-sm text-gray-500 font-medium mt-1">Спеціальність: <span class="text-gray-700">@resume.Specialty?.Name</span></p>
                                <p class="text-xs text-gray-400 mt-1">Оновлено: @resume.UpdatedAt.ToString("dd.MM.yyyy")</p>
                            </div>
                            <div class="flex items-center gap-3 text-sm font-semibold shrink-0">
                                <a href="#" class="text-brand-blue hover:brightness-75 transition-colors">Редагувати</a>
                                <span class="text-gray-300">|</span>
                                <a href="#" class="text-brand-red hover:brightness-75 transition-colors">Видалити</a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ПРАВА КОЛОНКА: Мої Заявки -->
        <div class="flex flex-col gap-5">
            <div class="flex items-center justify-between border-b-2 border-brand-cyan/40 pb-2">
                <h2 class="font-poppins font-bold text-xl text-brand-dark">Історія відгуків</h2>
            </div>

            @if (!Model.Applications.Any())
            {
                <div class="bg-gray-50 border border-gray-200 rounded-2xl p-8 text-center flex flex-col items-center justify-center h-full min-h-[200px]">
                    <p class="text-gray-500 text-sm">Ви ще не відгукувались на жодну вакансію.</p>
                </div>
            }
            else
            {
                <div class="flex flex-col gap-4">
                    @foreach (var app in Model.Applications)
                    {
                        <div class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm hover:border-brand-cyan transition-colors flex flex-col gap-3">

                            <div class="flex justify-between items-start gap-4">
                                <div>
                                    <h3 class="font-bold text-brand-dark text-lg line-clamp-1">
                                        <a asp-controller="Vacancies" asp-action="Details" asp-route-id="@app.VacancyId" class="hover:text-brand-blue transition-colors">@app.Vacancy?.Title</a>
                                    </h3>
                                    <p class="text-sm text-gray-500 font-medium mt-1">@app.Vacancy?.Company?.Name</p>
                                </div>

                                <!-- Статус заявки з application_statuses -->
                                <span class="shrink-0 bg-brand-mint/30 text-brand-dark text-xs font-bold px-3 py-1 rounded-md border border-brand-mint border-opacity-50">
                                    @app.ApplicationStatus?.Name
                                </span>
                            </div>

                            <div class="border-t border-gray-100 pt-3 flex justify-between items-center text-xs text-gray-400 font-medium mt-1">
                                <span>Дата подачі: @app.AppliedAt.ToString("dd.MM.yyyy")</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
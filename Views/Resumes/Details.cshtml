@model RecruitingPlatform.Entities.Resume;
@using RecruitingPlatform.Const.Resumes;
@{
    ViewData["Title"] = $"Резюме: {Model.Title}";
    var initials = $"{(Model.JobSeeker?.FirstName?.FirstOrDefault())}{(Model.JobSeeker?.LastName?.FirstOrDefault())}".ToUpper();
}

<main class="max-w-5xl flex-grow mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full relative flex flex-col font-inter">

    @if (TempData[ResumesConstants.SuccessMessageTempDataKey] != null)
    {
        <div class="mb-6 w-full bg-brand-mint/20 border border-brand-mint/50 text-brand-dark px-5 py-4 rounded-xl flex items-center shadow-sm transition-all animate-fade-in">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-brand-blue mr-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="font-medium text-sm sm:text-base">
                @TempData[ResumesConstants.SuccessMessageTempDataKey]
            </span>
        </div>
    }

    <div class="w-full bg-white rounded-2xl p-6 sm:p-8 border-t-4 border-t-brand-blue shadow-md flex flex-col md:flex-row items-start md:items-center gap-6 relative overflow-hidden">

        <div class="absolute -right-16 -top-16 w-64 h-64 bg-brand-light-blue rounded-full opacity-50 z-0 pointer-events-none"></div>

        <div class="z-10 shrink-0 w-20 h-20 sm:w-24 sm:h-24 bg-brand-mint text-brand-dark rounded-full flex items-center justify-center font-poppins font-bold text-3xl shadow-sm border-4 border-white">
            @initials
        </div>

        <div class="z-10 flex flex-col gap-2 w-full">
            <h1 class="font-poppins font-bold text-2xl sm:text-4xl text-brand-dark">
                @Model.JobSeeker?.FirstName @Model.JobSeeker?.LastName
            </h1>
            <h2 class="text-lg sm:text-xl font-semibold text-brand-blue">
                @Model.Title
            </h2>

            <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-600 mt-2">
                <span class="flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-red" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 4a1 1 0 10-2 0v4.293l-2.293 2.293a1 1 0 101.414 1.414L11 11.414V6z" clip-rule="evenodd" />
                    </svg>
                    Спеціальність: <b class="text-brand-dark">@Model.Specialty?.Name</b>
                </span>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-8">

        <div class="lg:col-span-2 flex flex-col gap-8">
            <section class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-gray-100">
                <h3 class="text-xl font-poppins font-bold text-brand-dark mb-4 border-l-4 border-brand-cyan pl-3">
                    Про кандидата
                </h3>
                <div class="text-sm sm:text-base text-gray-700 leading-relaxed">
                    @(string.IsNullOrWhiteSpace(Model.Summary) ? "Кандидат не надав опису." : Model.Summary)
                </div>
            </section>

            @if (Model.ResumeSkills != null && Model.ResumeSkills.Any())
            {
                <section class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-gray-100">
                    <h3 class="text-xl font-poppins font-bold text-brand-dark mb-4 border-l-4 border-brand-cyan pl-3">
                        Ключові навички
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var rs in Model.ResumeSkills)
                        {
                            <span class="text-sm sm:text-base font-semibold text-brand-dark bg-brand-cyan/20 px-3 py-1.5 rounded-lg border border-brand-cyan/50 shadow-sm transition-transform hover:scale-105">
                                @rs.Skill?.Name
                            </span>
                        }
                    </div>
                </section>
            }
        </div>

        <div class="flex flex-col gap-6">
            <div class="bg-brand-dark text-white p-6 rounded-2xl shadow-md">
                <h3 class="font-poppins font-bold text-lg mb-4 text-brand-mint">Контактна інформація</h3>

                <ul class="flex flex-col gap-4 text-sm sm:text-base">
                    <li class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-300" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                        </svg>
                        <a class="hover:text-brand-cyan transition-colors">
                            @Model.JobSeeker?.ContactEmail
                        </a>
                    </li>
                    <li class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-300" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
                        </svg>
                        <a class="hover:text-brand-cyan transition-colors">
                            @Model.JobSeeker?.ContactPhone
                        </a>
                    </li>
                </ul>
            </div>

            <div class="bg-gray-50 p-6 rounded-2xl border border-gray-200 text-xs sm:text-sm text-gray-500 flex flex-col gap-2">
                <p>Створено: <strong class="text-gray-700">@Model.CreatedAt.ToString("dd.MM.yyyy")</strong></p>
                <p>Оновлено: <strong class="text-gray-700">@Model.UpdatedAt.ToString("dd.MM.yyyy")</strong></p>
            </div>
        </div>
    </div>
</main>
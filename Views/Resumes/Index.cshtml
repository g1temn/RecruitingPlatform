@model IEnumerable<RecruitingPlatform.Entities.Resume>
@{
    ViewData["Title"] = "Резюме";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<form id="filterForm" method="get" asp-controller="Resumes" asp-action="Index" class="flex-grow mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full relative">

    <input type="hidden" id="pageIndex" name="page" value="@currentPage" />

    <div class="w-full bg-gradient-to-r from-brand-dark to-brand-blue rounded-2xl p-8 sm:p-10 mb-8 shadow-md relative overflow-hidden">
        <div class="absolute -right-10 -top-20 w-64 h-64 bg-brand-cyan/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10">
            <h1 class="font-poppins font-bold text-3xl sm:text-4xl lg:text-5xl text-white mb-2 sm:mb-4">
                Найкращі кандидати для вашого бізнесу
            </h1>
            <p class="font-inter text-base sm:text-lg text-white/90">
                У нашій базі <b class="text-brand-mint text-xl">@totalItems.ToString("N0")</b> професійних резюме.
            </p>
        </div>
    </div>

    <div class="flex flex-col gap-4 mb-6">
        <div class="flex flex-col sm:flex-row gap-4 justify-between items-center">
            <div class="w-full sm:w-2/3">
                <input type="text" id="search" name="searchQuery" placeholder="Посада, навички або ім'я кандидата..."
                       onchange="resetPage()"
                       class="w-full px-5 py-3 rounded-xl border border-gray-200 text-base shadow-sm focus:outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue transition-all placeholder:text-gray-400">
            </div>

            <div class="flex flex-col sm:flex-row gap-4 sm:gap-2 w-full sm:w-auto">
                <button type="submit" onclick="resetPage()" class="w-full sm:w-auto shrink-0 bg-brand-red text-white px-6 py-3 rounded-xl font-bold text-sm transition-all hover:bg-brand-red hover:brightness-75 focus:outline-none focus:ring-2 focus:ring-brand-red/50 flex items-center justify-center gap-2">
                    Пошук
                </button>

                <button type="button" onclick="toggleFilters()" class="w-full sm:w-auto shrink-0 bg-brand-dark text-white px-6 py-3 rounded-xl font-bold text-sm transition-all hover:bg-brand-blue focus:outline-none focus:ring-2 focus:ring-brand-dark/50 flex items-center justify-center gap-2">
                    Фільтри
                </button>
            </div>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="w-full flex-grow flex items-center justify-center bg-gray-50 rounded-2xl shadow-inner border border-gray-200 p-12 text-center">
            <p class="text-gray-500 font-medium text-lg">Не знайдено жодного резюме за вашим запитом.</p>
        </div>
    }
    else
    {
        <main class="w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var resume in Model)
            {
                var initials = $"{(resume.JobSeeker?.FirstName?.FirstOrDefault())}{(resume.JobSeeker?.LastName?.FirstOrDefault())}".ToUpper();

                <a asp-controller="Resumes" asp-action="Details" asp-route-id="@resume.Id"
                   class="h-full flex flex-col bg-white rounded-2xl shadow-sm border-t-4 border-t-brand-blue border-x border-b border-gray-100 p-6 transition-all hover:shadow-lg hover:-translate-y-1 group relative">

                    <div class="flex items-start gap-4 mb-4">
                        <div class="shrink-0 w-12 h-12 bg-brand-light-blue text-brand-dark rounded-full flex items-center justify-center font-bold text-lg">
                            @initials
                        </div>
                        <div>
                            <h3 class="font-poppins font-bold text-lg text-brand-dark group-hover:text-brand-blue transition-colors">
                                @resume.Title
                            </h3>
                            <p class="text-sm font-medium text-gray-500">
                                @resume.JobSeeker?.FirstName @resume.JobSeeker?.LastName
                            </p>
                        </div>
                    </div>

                    <div class="mb-4 text-xs font-semibold text-brand-dark bg-brand-mint/30 px-3 py-1.5 rounded-md inline-block w-fit">
                        @resume.Specialty?.Name
                    </div>

                    <p class="text-sm text-gray-600 mt-2 line-clamp-3 mb-4">
                        @(string.IsNullOrWhiteSpace(resume.Summary) ? "Опис відсутній." : resume.Summary)
                    </p>

                    <div class="flex flex-wrap gap-2 mt-auto pt-4 border-t border-gray-100">
                        @foreach (var rs in resume.ResumeSkills.Take(3))
                        {
                            <span class="text-xs font-semibold text-gray-600 bg-gray-100 px-2 py-1 rounded-md">
                                @rs.Skill?.Name
                            </span>
                        }
                        @if (resume.ResumeSkills.Count() > 3)
                        {
                            <span class="text-xs font-semibold text-brand-blue bg-brand-cyan/20 px-2 py-1 rounded-md">
                                +@(resume.ResumeSkills.Count() - 3)
                            </span>
                        }
                    </div>
                </a>
            }
        </main>

        @if (totalPages > 1)
        {
            <div class="col-span-1 sm:col-span-2 lg:col-span-3 flex justify-center items-center gap-4 mt-8 bg-white py-4 rounded-2xl shadow-sm border border-gray-100">
                <button type="button"
                        onclick="changePage(@(currentPage - 1))"
                        disabled="@(currentPage == 1)"
                        class="px-4 py-2 rounded-lg text-sm font-semibold transition-all @(currentPage == 1 ? "bg-gray-100 text-gray-400 cursor-not-allowed" : "bg-brand-light-blue text-brand-blue hover:bg-brand-blue hover:text-white")">
                    &larr; Попередня
                </button>

                <span class="text-sm font-medium text-gray-600">
                    Сторінка <b class="text-brand-dark">@currentPage</b> з <b class="text-brand-dark">@totalPages</b>
                </span>

                <button type="button"
                        onclick="changePage(@(currentPage + 1))"
                        disabled="@(currentPage == totalPages)"
                        class="px-4 py-2 rounded-lg text-sm font-semibold transition-all @(currentPage == totalPages ? "bg-gray-100 text-gray-400 cursor-not-allowed" : "bg-brand-light-blue text-brand-blue hover:bg-brand-blue hover:text-white")">
                    Наступна &rarr;
                </button>
            </div>
        }
    }

    <div id="filterOverlay" onclick="toggleFilters()" class="fixed inset-0 bg-black/40 z-40 hidden transition-opacity"></div>
    <aside id="filterDrawer" class="fixed top-0 right-0 h-full w-full max-w-sm bg-white shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
        <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-brand-light-blue">
            <h2 class="font-poppins text-xl font-bold text-brand-dark">Фільтри кандидатів</h2>
            <button type="button" onclick="toggleFilters()" class="text-brand-dark hover:text-brand-red transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="p-6 space-y-6 overflow-y-auto flex-1">
            <div>
                <label for="specialty" class="block text-sm font-semibold text-gray-700 mb-1.5">Спеціальність</label>
                <select id="specialty" name="specialtyId" onchange="resetPage()" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/20 transition-all bg-white">
                    <option value="">Всі спеціальності</option>
                </select>
            </div>
        </div>

        <div class="p-6 border-t border-gray-100 bg-gray-50 flex gap-4">
            <button type="reset" onclick="resetPage(); toggleFilters();" class="w-1/3 bg-white text-gray-600 py-3 rounded-xl font-semibold border border-gray-200 hover:bg-gray-100 transition-colors">
                Скинути
            </button>
            <button type="submit" onclick="resetPage()" class="w-2/3 bg-brand-blue text-white py-3 rounded-xl font-bold text-sm transition-all hover:bg-brand-dark focus:outline-none focus:ring-2 focus:ring-brand-blue/50">
                Застосувати
            </button>
        </div>
    </aside>

</form>

<script>
    function toggleFilters() {
        const drawer = document.getElementById('filterDrawer');
        const overlay = document.getElementById('filterOverlay');
        drawer.classList.toggle('translate-x-full');
        if (overlay.classList.contains('hidden')) {
            overlay.classList.remove('hidden');
        } else {
            overlay.classList.add('hidden');
        }
    }
    function changePage(newPage) {
        document.getElementById('pageIndex').value = newPage;
        document.getElementById('filterForm').submit();
    }
    function resetPage() {
        document.getElementById('pageIndex').value = 1;
    }
</script>
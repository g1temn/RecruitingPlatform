@model RecruitingPlatform.DTOs.Error.ErrorViewModel;
@{
    ViewData["Title"] = "Помилка";
}

<main class="flex-grow flex items-center justify-center py-20 px-4 sm:px-6 font-inter bg-brand-light-blue">
    <div class="max-w-xl w-full bg-white rounded-3xl shadow-xl border border-gray-100 p-8 sm:p-12 text-center relative overflow-hidden">

        <div class="absolute -top-24 -right-24 w-48 h-48 bg-brand-red/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col items-center">
            <div class="w-20 h-20 bg-brand-red/10 text-brand-red rounded-full flex items-center justify-center mb-6">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>

            <h1 class="font-poppins font-bold text-3xl sm:text-4xl text-brand-dark mb-4">
                Упс! Щось пішло не так.
            </h1>

            <p class="text-gray-600 mb-8 text-sm sm:text-base">
                Ми вже залогували цю помилку, і наші розробники отримали сповіщення. Вибачте за тимчасові незручності.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 mb-8 w-full text-left">
                    <p class="text-xs text-gray-500 font-semibold uppercase tracking-wider mb-1">ID запиту для власника та розробників сайту:</p>
                    <code class="text-sm text-brand-dark font-mono">@Model.RequestId</code>
                </div>
            }

            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center justify-center px-8 py-3 bg-brand-blue text-white font-bold rounded-xl hover:bg-brand-dark transition-colors shadow-sm focus:ring-4 focus:ring-brand-blue/30">
                Повернутися на головну
            </a>
        </div>
    </div>
</main>
@model RecruitingPlatform.ViewModels.Profile.EmployerProfileViewModel
@{
    ViewData["Title"] = "Профіль роботодавця";
    var initials = Model.Name.Length >= 2 ? Model.Name.Substring(0, 2).ToUpper() : Model.Name.ToUpper();
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full font-inter flex-grow">

    <div class="bg-white rounded-2xl p-6 sm:p-10 shadow-sm border border-brand-cyan/30 flex flex-col sm:flex-row items-center sm:items-start gap-6 relative overflow-hidden mb-8">

        <div class="absolute -right-16 -top-16 w-64 h-64 bg-brand-light-blue rounded-full opacity-50 z-0 pointer-events-none"></div>

        <div class="z-10 w-24 h-24 bg-brand-dark text-white rounded-2xl flex items-center justify-center font-poppins font-bold text-3xl shadow-sm border-4 border-white shrink-0">
            @initials
        </div>

        <div class="z-10 flex flex-col items-center sm:items-start gap-2 w-full">
            <h1 class="font-poppins font-bold text-3xl text-brand-dark">@Model.Name</h1>

            <p class="text-sm text-gray-600 max-w-2xl text-center sm:text-left mt-1 line-clamp-2">
                @(string.IsNullOrWhiteSpace(Model.Description) ? "Опис роботодавця не додано." : Model.Description)
            </p>

            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-x-6 gap-y-3 text-sm text-brand-blue mt-3 font-medium">
                @if (!string.IsNullOrWhiteSpace(Model.WebsiteUrl))
                {
                    <a href="@Model.WebsiteUrl" target="_blank" class="flex items-center gap-2 hover:text-brand-dark transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-mint" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                        </svg>
                        @Model.WebsiteUrl
                    </a>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ContactPhone))
                {
                    <span class="flex items-center gap-2 text-gray-600">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                        @Model.ContactPhone
                    </span>
                }
            </div>
        </div>

        <a asp-controller="EmployerProfile" asp-action="Edit" class="text-center z-10 sm:ml-auto mt-4 sm:mt-0 px-6 py-2 bg-brand-light-blue text-brand-dark font-semibold rounded-xl hover:bg-brand-blue hover:text-white transition-colors text-sm border border-gray-200 shadow-sm">
            Редагувати профіль
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        <div class="flex flex-col gap-5">
            <div class="flex items-center justify-between border-b-2 border-brand-cyan/40 pb-2">
                <h2 class="font-poppins font-bold text-xl text-brand-dark">Наші вакансії</h2>
                <a asp-controller="Vacancies" asp-action="Create" class="text-sm font-bold text-brand-blue hover:text-brand-dark transition-colors flex items-center gap-1">
                    + Додати вакансію
                </a>
            </div>

            @if (!Model.Vacancies.Any())
            {
                <div class="bg-gray-50 border border-gray-200 rounded-2xl p-8 text-center flex flex-col items-center justify-center">
                    <p class="text-gray-500 text-sm mb-4">У вас ще немає жодної вакансії. Створіть її, щоб почати пошук кандидатів!</p>
                    <a asp-controller="Vacancies" asp-action="Create" class="px-6 py-2 bg-brand-blue text-white font-bold rounded-xl hover:bg-brand-dark transition-colors text-sm">Створити вакансію</a>
                </div>
            }
            else
            {
                <div class="flex flex-col gap-4">
                    @foreach (var vacancy in Model.Vacancies)
                    {
                        <div class="bg-white border-l-4 border-brand-blue border-y border-r border-gray-200 rounded-r-2xl p-5 shadow-sm hover:shadow-md transition-shadow flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <div>
                                <div class="flex items-center gap-3 mb-1">
                                    <h3 class="font-bold text-brand-dark text-lg">
                                        <a asp-controller="Vacancies" asp-action="Details" asp-route-id="@vacancy.Id" class="hover:text-brand-blue transition-colors">@vacancy.Title</a>
                                    </h3>
                                    @if (vacancy.IsActive)
                                    {
                                        <span class="bg-brand-mint/30 text-brand-dark text-[10px] uppercase font-bold px-2 py-0.5 rounded-sm">Активна</span>
                                    }
                                    else
                                    {
                                        <span class="bg-gray-200 text-gray-600 text-[10px] uppercase font-bold px-2 py-0.5 rounded-sm">Закрита</span>
                                    }
                                </div>
                                <p class="text-sm text-gray-500 font-medium">Локація: <span class="text-gray-700">@(vacancy.IsRemote ? "Віддалено" : vacancy.Location?.City ?? "Не вказано")</span></p>
                                <p class="text-xs text-gray-400 mt-1">Створено: @vacancy.CreatedAt.ToString("dd.MM.yyyy")</p>
                            </div>
                            <div class="flex items-center gap-3 text-sm font-semibold shrink-0">
                                <div class="flex items-center gap-3 text-sm font-semibold shrink-0">
                                    <a asp-controller="Vacancies" asp-action="Edit" asp-route-id="@vacancy.Id" class="text-brand-blue hover:brightness-75 transition-colors">Редагувати</a>
                                </div>
                                <span class="text-gray-300">|</span>
                                <form asp-controller="Vacancies" asp-action="Delete" asp-route-id="@vacancy.Id" method="post" class="inline" onsubmit="return confirm('Ви впевнені, що хочете видалити це резюме?');">
                                    <button type="submit" class="text-brand-red hover:brightness-75 transition-colors bg-transparent border-none p-0 cursor-pointer font-semibold">
                                        Видалити
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="flex flex-col gap-5">
            <div class="flex items-center justify-between border-b-2 border-brand-cyan/40 pb-2">
                <h2 class="font-poppins font-bold text-xl text-brand-dark">Нові відгуки</h2>
            </div>

            @if (!Model.RecentApplications.Any())
            {
                <div class="bg-gray-50 border border-gray-200 rounded-2xl p-8 text-center flex flex-col items-center justify-center h-full min-h-[200px]">
                    <p class="text-gray-500 text-sm">На ваші вакансії поки немає відгуків від кандидатів.</p>
                </div>
            }
            else
            {
                <div class="flex flex-col gap-4">
                    @foreach (var app in Model.RecentApplications)
                    {
                        <div class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm hover:border-brand-cyan transition-colors flex flex-col gap-3">

                            <div class="flex justify-between items-start gap-4">
                                <div>
                                    <h3 class="font-bold text-brand-dark text-lg line-clamp-1">
                                        <a asp-controller="Resumes" asp-action="Details" asp-route-id="@app.ResumeId" class="hover:text-brand-blue transition-colors">
                                            @app.Resume?.JobSeeker?.FirstName @app.Resume?.JobSeeker?.LastName
                                        </a>
                                    </h3>
                                    <p class="text-sm text-brand-blue font-medium mt-1">На вакансію: <span class="text-gray-600">@app.Vacancy?.Title</span></p>
                                </div>

                                <span class="shrink-0 bg-brand-light-blue text-brand-dark text-xs font-bold px-3 py-1 rounded-md border border-brand-dark/20">
                                    @app.ApplicationStatus?.Name
                                </span>
                            </div>

                            <div class="border-t border-gray-100 pt-3 flex justify-between items-center text-xs text-gray-500 font-medium mt-1">
                                <span>Дата: @app.AppliedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                <a asp-controller="ApplicationReview" asp-action="Review" asp-route-id=@app.Id class="text-brand-red hover:text-brand-dark transition-colors font-bold">Розглянути &rarr;</a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
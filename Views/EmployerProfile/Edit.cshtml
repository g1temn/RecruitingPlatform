@model RecruitingPlatform.ViewModels.Employers.EditEmployerViewModel
@using RecruitingPlatform.Const.Employers
@{
    ViewData["Title"] = "Редагування профілю компанії";
}

<main class="max-w-4xl flex-grow mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 w-full font-inter">

    @if (TempData[EmployerProfileConstants.SuccessMessageTempDataKey] != null)
    {
        <div class="mb-6 w-full bg-brand-mint/20 border border-brand-mint/50 text-brand-dark px-5 py-4 rounded-xl flex items-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-brand-blue mr-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="font-medium text-sm sm:text-base">
                @TempData[EmployerProfileConstants.SuccessMessageTempDataKey]
            </span>
        </div>
    }

    <div class="mb-8">
        <h1 class="font-poppins font-bold text-3xl sm:text-4xl text-brand-dark">
            Профіль компанії
        </h1>
        <p class="text-gray-500 mt-2 text-sm sm:text-base">
            Оновіть інформацію про вашу компанію, щоб кандидати мали про неї актуальне уявлення.
        </p>
    </div>

    <form asp-controller="EmployerProfile" asp-action="Edit" method="post" class="bg-white p-6 sm:p-10 rounded-2xl border border-gray-200 shadow-sm flex flex-col gap-6">

        <div asp-validation-summary="ModelOnly" class="text-brand-red font-medium text-sm p-4 bg-brand-red/10 border border-brand-red/20 rounded-xl"></div>

        <div class="flex flex-col gap-2">
            <label asp-for="FormData.Name" class="font-poppins font-bold text-brand-dark text-base">
                Назва компанії <span class="text-brand-red">*</span>
            </label>
            <input asp-for="FormData.Name" type="text"
                   class="w-full px-5 py-3 rounded-xl border border-gray-200 focus:outline-none focus:border-brand-blue focus:ring-4 focus:ring-brand-blue/10 transition-all text-sm sm:text-base placeholder:text-gray-400" required>
            <span asp-validation-for="FormData.Name" class="text-brand-red text-sm font-medium"></span>
        </div>

        <div class="flex flex-col gap-2">
            <label asp-for="FormData.Description" class="font-poppins font-bold text-brand-dark text-base">
                Опис компанії
            </label>
            <textarea asp-for="FormData.Description" rows="6"
                      class="w-full px-5 py-4 rounded-xl border border-gray-200 bg-gray-50/50 focus:bg-white focus:outline-none focus:border-brand-blue focus:ring-4 focus:ring-brand-blue/10 transition-all resize-y text-sm sm:text-base placeholder:text-gray-400"
                      placeholder="Розкажіть про місію, цінності та чим займається ваша компанія..."></textarea>
            <span asp-validation-for="FormData.Description" class="text-brand-red text-sm font-medium"></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex flex-col gap-2">
                <label asp-for="FormData.ContactPhone" class="font-poppins font-bold text-brand-dark text-base">
                    Контактний телефон
                </label>
                <input asp-for="FormData.ContactPhone" type="tel"
                       class="w-full px-5 py-3 rounded-xl border border-gray-200 focus:outline-none focus:border-brand-blue focus:ring-4 focus:ring-brand-blue/10 transition-all text-sm sm:text-base placeholder:text-gray-400">
                <span asp-validation-for="FormData.ContactPhone" class="text-brand-red text-sm font-medium"></span>
            </div>

            <div class="flex flex-col gap-2">
                <label asp-for="FormData.WebsiteUrl" class="font-poppins font-bold text-brand-dark text-base">
                    Вебсайт
                </label>
                <input asp-for="FormData.WebsiteUrl" type="url"
                       class="w-full px-5 py-3 rounded-xl border border-gray-200 focus:outline-none focus:border-brand-blue focus:ring-4 focus:ring-brand-blue/10 transition-all text-sm sm:text-base placeholder:text-gray-400"
                       placeholder="https://example.com">
                <span asp-validation-for="FormData.WebsiteUrl" class="text-brand-red text-sm font-medium"></span>
            </div>
        </div>

        <div class="pt-8 border-t border-gray-100 flex flex-col sm:flex-row justify-end gap-4 mt-2">
            <a href="javascript:history.back()" class="w-full sm:w-auto px-8 py-3.5 bg-gray-100 text-gray-700 text-center font-bold rounded-xl transition-all hover:bg-gray-200 duration-200 text-sm sm:text-base">
                Скасувати
            </a>
            <button type="submit" class="w-full sm:w-auto px-10 py-3.5 bg-brand-blue text-white font-poppins font-bold rounded-xl shadow-md transition-all hover:bg-brand-dark hover:-translate-y-0.5 hover:shadow-lg focus:ring-4 focus:ring-brand-blue/30 duration-200 text-sm sm:text-base">
                Зберегти зміни
            </button>
        </div>
    </form>
</main>
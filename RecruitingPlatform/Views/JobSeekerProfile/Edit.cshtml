@model RecruitingPlatform.ViewModels.JobSeekers.EditJobSeekerViewModel
@using RecruitingPlatform.Const.JobSeekers
@{
    ViewData["Title"] = "Редагування профілю";
}

<main class="max-w-3xl flex-grow mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 w-full font-inter">

    @if (TempData[JobSeekerProfileConstants.SuccessMessageTempDataKey] != null)
    {
        <div class="mb-6 w-full bg-brand-mint/20 border border-brand-mint/50 text-brand-dark px-5 py-4 rounded-xl flex items-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-brand-blue mr-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="font-medium text-sm sm:text-base">
                @TempData[JobSeekerProfileConstants.SuccessMessageTempDataKey]
            </span>
        </div>
    }

    <div class="mb-8">
        <h1 class="font-poppins font-bold text-3xl sm:text-4xl text-brand-dark">
            Особиста інформація
        </h1>
        <p class="text-gray-500 mt-2 text-sm sm:text-base">
            Оновіть свої контактні дані та особисту інформацію, щоб роботодавці могли з вами зв'язатися.
        </p>
    </div>

    <form asp-controller="JobSeekerProfile" asp-action="Edit" method="post" class="bg-white p-6 sm:p-10 rounded-2xl border border-gray-200 shadow-sm flex flex-col gap-6">

        <div asp-validation-summary="ModelOnly" class="text-brand-red font-medium text-sm p-4 bg-brand-red/10 border border-brand-red/20 rounded-xl"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex flex-col gap-2">
                <label asp-for="FormData.FirstName" class="font-poppins font-bold text-brand-dark text-base">
                    Ім'я <span class="text-brand-red">*</span>
                </label>
                <input asp-for="FormData.FirstName" type="text"
                       class="w-full px-5 py-3 rounded-xl border border-gray-200 focus:outline-none focus:border-brand-blue focus:ring-4 focus:ring-brand-blue/10 transition-all text-sm sm:text-base placeholder:text-gray-400" required>
                <span asp-validation-for="FormData.FirstName" class="text-brand-red text-sm font-medium"></span>
            </div>

            <div class="flex flex-col gap-2">
                <label asp-for="FormData.LastName" class="font-poppins font-bold text-brand-dark text-base">
                    Прізвище <span class="text-brand-red">*</span>
                </label>
                <input asp-for="FormData.LastName" type="text"
                       class="w-full px-5 py-3 rounded-xl border border-gray-200 focus:outline-none focus:border-brand-blue focus:ring-4 focus:ring-brand-blue/10 transition-all text-sm sm:text-base placeholder:text-gray-400" required>
                <span asp-validation-for="FormData.LastName" class="text-brand-red text-sm font-medium"></span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex flex-col gap-2">
                <label asp-for="FormData.ContactEmail" class="font-poppins font-bold text-brand-dark text-base">
                    Контактний Email <span class="text-brand-red">*</span>
                </label>
                <input asp-for="FormData.ContactEmail" type="email"
                       class="w-full px-5 py-3 rounded-xl border border-gray-200 focus:outline-none focus:border-brand-blue focus:ring-4 focus:ring-brand-blue/10 transition-all text-sm sm:text-base placeholder:text-gray-400" required>
                <span asp-validation-for="FormData.ContactEmail" class="text-brand-red text-sm font-medium"></span>
            </div>

            <div class="flex flex-col gap-2">
                <label asp-for="FormData.ContactPhone" class="font-poppins font-bold text-brand-dark text-base">
                    Номер телефону <span class="text-brand-red">*</span>
                </label>
                <input asp-for="FormData.ContactPhone" type="tel"
                       class="w-full px-5 py-3 rounded-xl border border-gray-200 focus:outline-none focus:border-brand-blue focus:ring-4 focus:ring-brand-blue/10 transition-all text-sm sm:text-base placeholder:text-gray-400" required>
                <span asp-validation-for="FormData.ContactPhone" class="text-brand-red text-sm font-medium"></span>
            </div>
        </div>

        <div class="flex flex-col gap-2 w-full md:w-1/2 md:pr-3">
            <label asp-for="FormData.Birthday" class="font-poppins font-bold text-brand-dark text-base">
                Дата народження <span class="text-brand-red">*</span>
            </label>
            <input asp-for="FormData.Birthday" type="date"
                   class="w-full px-5 py-3 rounded-xl border border-gray-200 focus:outline-none focus:border-brand-blue focus:ring-4 focus:ring-brand-blue/10 transition-all text-sm sm:text-base text-gray-700 bg-white" required>
            <span asp-validation-for="FormData.Birthday" class="text-brand-red text-sm font-medium"></span>
        </div>

        <div class="pt-8 border-t border-gray-100 flex flex-col sm:flex-row justify-end gap-4 mt-2">
            <a href="javascript:history.back()" class="w-full sm:w-auto px-8 py-3.5 bg-gray-100 text-gray-700 text-center font-bold rounded-xl transition-all hover:bg-gray-200 duration-200 text-sm sm:text-base">
                Скасувати
            </a>
            <button type="submit" class="w-full sm:w-auto px-10 py-3.5 bg-brand-blue text-white font-poppins font-bold rounded-xl shadow-md transition-all hover:bg-brand-dark hover:-translate-y-0.5 hover:shadow-lg focus:ring-4 focus:ring-brand-blue/30 duration-200 text-sm sm:text-base">
                Зберегти зміни
            </button>
        </div>
    </form>
</main>
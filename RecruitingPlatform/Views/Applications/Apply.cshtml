@model RecruitingPlatform.ViewModels.Applications.ApplyViewModel
@{
    ViewData["Title"] = "Подача заявки на вакансію";
}

<main class="max-w-6xl flex-grow mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 w-full relative flex flex-col font-inter">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 w-full bg-brand-red/10 border border-brand-red/30 text-brand-red px-5 py-4 rounded-xl flex items-center gap-3 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="font-medium text-sm sm:text-base">@TempData["ErrorMessage"]</span>
        </div>
    }

    <div class="mb-6 sm:mb-8 flex flex-col gap-2">
        <a asp-controller="Vacancies" asp-action="Details" asp-route-id="@Model.Vacancy.Id"
           class="text-brand-blue hover:text-brand-dark font-medium flex items-center gap-2 transition-colors w-fit text-sm sm:text-base">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Повернутися до вакансії
        </a>
        <h1 class="font-poppins font-bold text-2xl sm:text-3xl lg:text-4xl text-brand-dark">
            Відгук на вакансію
        </h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 sm:gap-8">

        <div class="lg:col-span-2 flex flex-col gap-4">
            <div class="bg-brand-light-blue p-6 sm:p-8 rounded-2xl border border-brand-cyan/30 shadow-sm sticky top-6">
                <span class="inline-block bg-brand-mint/40 text-brand-dark text-xs sm:text-sm font-bold px-3 py-1 rounded-full uppercase tracking-wide mb-4">
                    Деталі вакансії
                </span>

                <h2 class="font-poppins font-bold text-xl sm:text-2xl text-brand-dark mb-2">
                    @Model.Vacancy.Title
                </h2>

                <div class="flex items-center gap-2 text-brand-blue font-semibold text-sm sm:text-base mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd" />
                    </svg>
                    @Model.Vacancy.Company?.Name
                </div>

                <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm text-sm sm:text-base text-gray-600 flex flex-col gap-3">
                    <p class="flex items-start gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-cyan shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span>Ваше резюме та супровідний лист будуть надіслані безпосередньо роботодавцю.</span>
                    </p>
                </div>
            </div>
        </div>

        <div class="lg:col-span-3">
            <form asp-controller="Applications" asp-action="Apply" method="post" class="bg-white p-6 sm:p-8 rounded-2xl border border-gray-200 shadow-sm flex flex-col gap-8">

                <input type="hidden" asp-for="FormData.VacancyId" value="@Model.Vacancy.Id" />

                <div class="flex flex-col gap-4">
                    <h3 class="font-poppins font-bold text-brand-dark text-lg sm:text-xl border-b-2 border-brand-cyan/40 pb-2">
                        Оберіть резюме <span class="text-brand-red">*</span>
                    </h3>
                    <div class="grid grid-cols-1 gap-4">
                        @foreach (var resume in Model.UserResumes)
                        {
                            <label class="group relative flex items-start gap-4 p-4 sm:p-5 border-2 border-gray-100 rounded-xl cursor-pointer transition-all duration-200 hover:border-brand-cyan hover:bg-brand-light-blue has-[:checked]:border-brand-blue has-[:checked]:bg-brand-light-blue has-[:checked]:shadow-md">
                                <div class="flex items-center h-6 mt-1">
                                    <input type="radio" asp-for="FormData.ResumeId" value="@resume.Id" class="w-5 h-5 text-brand-blue border-gray-300 focus:ring-brand-blue transition-colors" required>
                                </div>
                                <div class="flex flex-col gap-1 w-full">
                                    <div class="font-bold text-brand-dark text-base sm:text-lg group-hover:text-brand-blue transition-colors">@resume.Title</div>
                                    <div class="text-xs sm:text-sm text-gray-500 line-clamp-1">Оновлено: @resume.UpdatedAt.ToString("dd.MM.yyyy")</div>
                                </div>
                            </label>
                        }
                    </div>
                </div>

                <div class="flex flex-col gap-4">
                    <div class="flex flex-col gap-1">
                        <h3 class="font-poppins font-bold text-brand-dark text-lg sm:text-xl border-b-2 border-brand-cyan/40 pb-2">
                            Супровідний лист <span class="text-gray-400 font-medium text-sm sm:text-base">(Необов'язково)</span>
                        </h3>
                        <p class="text-xs sm:text-sm text-gray-500 mt-2">Коротко опишіть, чому ваш досвід є релевантним для цієї позиції.</p>
                    </div>

                    <textarea asp-for="FormData.CoverLetter" id="coverLetter" rows="6"
                              class="w-full px-5 py-4 rounded-xl border border-gray-200 bg-gray-50/50 focus:bg-white focus:outline-none focus:border-brand-blue focus:ring-4 focus:ring-brand-blue/10 transition-all resize-y text-sm sm:text-base placeholder:text-gray-400"
                              placeholder="Доброго дня! Я зацікавлений(а) у цій вакансії, оскільки..."></textarea>
                </div>

                <div class="pt-6 border-t border-gray-100 flex justify-end">
                    <button type="submit" class="w-full sm:w-auto px-10 py-3.5 bg-brand-red text-white font-poppins font-bold rounded-xl shadow-md transition-all hover:bg-brand-dark hover:-translate-y-0.5 hover:shadow-lg focus:ring-4 focus:ring-brand-red/30 duration-200 text-base sm:text-lg">
                        Відправити заявку
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>
@model RecruitingPlatform.Entities.Vacancy;
@{
    ViewData["Title"] = $"Details Vacancy #{Model.Id}";
}

<main class="max-w-7xl flex-grow mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full relative flex flex-col font-inter">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 w-full bg-brand-mint/20 border border-brand-mint/50 text-brand-dark px-5 py-4 rounded-xl flex items-center gap-3 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-brand-blue shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="font-semibold text-sm sm:text-base">@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="w-full bg-brand-light-blue rounded-2xl p-6 sm:p-8 border border-brand-cyan/30 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-6">

        <div class="flex flex-col gap-3 w-full md:w-3/4">
            <div class="flex flex-wrap items-center gap-3">
                <h1 class="font-poppins font-bold text-3xl sm:text-4xl lg:text-5xl text-brand-dark transition-colors">
                    @Model.Title
                </h1>

                @if (Model.IsActive)
                {
                    <span class="bg-brand-mint text-brand-dark text-xs sm:text-sm font-bold px-3 py-1 rounded-full uppercase tracking-wide">Активна</span>
                }
                else
                {
                    <span class="bg-gray-300 text-gray-700 text-xs sm:text-sm font-bold px-3 py-1 rounded-full uppercase tracking-wide">Неактивна</span>
                }
            </div>

            <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm sm:text-base font-medium text-brand-blue">
                <a asp-controller="Company" asp-action="PublicProfile" asp-route-id="@Model?.Company.Id"
                   class="hover:text-brand-dark transition-colors flex items-center gap-1 font-bold">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd" />
                    </svg>
                    @Model.Company?.Name
                </a>

                <span class="flex items-center gap-1 text-gray-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                    </svg>
                    @(Model.IsRemote ? "Віддалена робота" : Model?.Location?.City ?? "Без локації")
                </span>

                <span class="flex items-center gap-1 text-gray-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 4a1 1 0 10-2 0v4.293l-2.293 2.293a1 1 0 101.414 1.414L11 11.414V6z" clip-rule="evenodd" />
                    </svg>
                    Спеціальність: <span class="font-semibold text-brand-dark">@Model.Specialty?.Name</span>
                </span>
            </div>
        </div>

        @if (Model.MinSalary.HasValue || Model.MaxSalary.HasValue)
        {
            <div class="shrink-0 bg-white shadow-sm border border-brand-mint text-brand-dark font-poppins font-bold text-lg sm:text-xl lg:text-2xl px-5 py-3 rounded-xl flex items-center justify-center">
                @if (Model.MinSalary == Model.MaxSalary)
                {
                    @($"{Model.MinSalary?.ToString("N0")} {Model.Currency?.Name}")
                }
                else if (Model.MinSalary.HasValue && Model.MaxSalary.HasValue)
                {
                    @($"{Model.MinSalary?.ToString("N0")} - {Model.MaxSalary?.ToString("N0")} {Model.Currency?.Name}")
                }
                else if (Model.MinSalary.HasValue)
                {
                    @($"Від {Model.MinSalary?.ToString("N0")} {Model.Currency?.Name}")
                }
                else
                {
                    @($"До {Model.MaxSalary?.ToString("N0")} {Model.Currency?.Name}")
                }
            </div>
        }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-8">

        <div class="lg:col-span-2 flex flex-col gap-8">
            <section>
                <h2 class="text-xl sm:text-2xl font-poppins font-bold text-brand-dark mb-4 border-b-2 border-brand-cyan/40 pb-2">
                    Опис вакансії
                </h2>
                <div class="text-sm sm:text-base text-gray-700 leading-relaxed">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "Немає опису" : Model.Description)
                </div>
            </section>

            @if (Model.VacancySkills != null && Model.VacancySkills.Any())
            {
                <section>
                    <h2 class="text-xl sm:text-2xl font-poppins font-bold text-brand-dark mb-4 border-b-2 border-brand-cyan/40 pb-2">
                        Необхідні навички
                    </h2>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var vs in Model.VacancySkills)
                        {
                            <span class="text-sm sm:text-base font-semibold text-brand-dark bg-brand-cyan/20 px-3 py-1.5 rounded-lg border border-brand-cyan/50 shadow-sm transition-transform hover:scale-105">
                                @vs.Skill?.Name
                            </span>
                        }
                    </div>
                </section>
            }
        </div>

        <div class="flex flex-col gap-6">
            <div class="bg-brand-light-blue p-6 rounded-2xl border border-gray-200 shadow-sm">
                <h3 class="font-poppins font-bold text-lg text-brand-dark mb-4">Деталі публікації</h3>

                <ul class="flex flex-col gap-4 text-sm sm:text-base text-gray-600">
                    <li class="flex justify-between items-start gap-4 border-b border-gray-200 pb-2">
                        <span class="text-brand-blue font-medium">Опубліковано:</span>
                        <span class="font-semibold text-brand-dark text-right">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                    </li>
                    <li class="flex justify-between items-start gap-4 border-b border-gray-200 pb-2">
                        <span class="text-brand-blue font-medium">Останнє оновлення:</span>
                        <span class="font-semibold text-brand-dark text-right">@Model.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                    </li>
                    <li class="flex justify-between items-start gap-4 border-b border-gray-200 pb-2">
                        <span class="text-brand-blue font-medium">Формат роботи:</span>
                        <span class="font-semibold text-brand-dark text-right">@(Model.IsRemote ? "Віддалено" : "На місці")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="mt-12 w-full flex flex-row justify-end border-t border-gray-200 pt-6">
        <a asp-controller="Applications" asp-action="Apply" asp-route-vacancyId="@Model.Id"
           class="py-3 px-8 bg-brand-red text-white text-center rounded-xl font-poppins font-bold text-lg shadow-lg transition-all hover:brightness-75 duration-125 w-full sm:w-auto">
            Відгукнутись на вакансію
        </a>
    </div>

</main>